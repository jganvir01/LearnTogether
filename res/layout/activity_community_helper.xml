<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".community_helper"
    android:background="@drawable/community_helper">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl1"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        app:tabTextColor="#009688" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp1"
        android:layout_width="195dp"
        android:layout_height="195dp"
        android:layout_below="@id/tl1"
        android:layout_marginLeft="100dp"
        android:layout_marginTop="40dp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl2"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="420dp"
        app:tabTextColor="#009688" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp2"
        android:layout_width="195dp"
        android:layout_height="195dp"
        android:layout_below="@id/tl2"
        android:layout_marginLeft="510dp"
        android:layout_marginTop="40dp" />

    <Button
        android:id="@+id/community_to_home"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="345dp"
        android:background="@drawable/custom_community"
        android:onClick="community_to_home"
        android:text="home" />

    <Button
        android:id="@+id/community_to_english"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_marginLeft="710dp"
        android:layout_marginTop="345dp"
        android:background="@drawable/custom_community"
        android:onClick="community_to_english"
        android:text="english" />

</RelativeLayout>

